  {"id": 10, "title": "Long odds", "briefing": ["You played The hunt well enough to unlock a secret, harder stage.", "This start is unfair on purpose. Actuary is seven turns from your home and marshal ten, while knower builds unbothered far across the map.", "Two hunters will reach you before you have grown. Whoever you fight first, the other is coming.", "If you can, let them meet each other before they meet you."], "hint": "Two rivals are close and one is far. Make the near ones pay for every system.", "settings": {"mode": "random", "layout": "hub", "players": 4, "nodes": 14, "seed": 20837074, "autoplay": false, "node_jitter": 0.85, "relax_min_sep_frac": 0.5, "lloyd_passes": 1, "extra_edge_fraction": 0.5, "max_edge_length_frac": 0.6, "ship_ly_per_turn": 7.5, "ship_speed_growth_pct": 0.0, "home_start_ships": 12, "home_production": 2, "garrison_base": 2, "garrison_k": 12, "garrison_jitter": 3, "combat_jitter": 0.08, "defender_advantage": 1.05, "neutral_produces": false, "in_lane_battles": false, "fog_sight": 8, "fog_scout": 8, "ai": [{"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1}, {"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1}, {"reserve_fraction": 0.0, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 2.0}, {"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1.0}, {"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1.0}, {"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1.0}], "ai_strategy": ["heuristic", "marshal", "knower", "actuary", "heuristic", "heuristic"], "custom_map": null, "challenge": null}},
