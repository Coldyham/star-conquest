  {"id": 2, "title": "Crossing in flight", "briefing": ["The number on each lane is how many turns it takes to cross. Ships are slow here.", "Ships you send leave home at once, and fight when they arrive. Fleets in flight don't interact.", "This rival rushes. Send everything away and it will walk into the system you left empty.", "Keep a guard at home, and count the turns before you commit."], "hint": "Lane numbers are turns to cross. Ships in flight don't fight.",
   "settings": {"mode": "random", "layout": "hub", "players": 2, "nodes": 14, "seed": 3004, "autoplay": false, "node_jitter": 0.85, "relax_min_sep_frac": 0.6, "lloyd_passes": 1, "extra_edge_fraction": 0.4, "max_edge_length_frac": 0.5, "ship_ly_per_turn": 4.0, "ship_speed_growth_pct": 0.0, "home_start_ships": 12, "home_production": 3, "garrison_base": 2, "garrison_k": 12, "garrison_jitter": 3, "combat_jitter": 0.1, "defender_advantage": 1.0, "neutral_produces": false, "in_lane_battles": false, "fog_sight": 8, "fog_scout": 8, "ai": [{"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1.0}, {"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1.0}, {"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1.0}, {"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1.0}, {"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1.0}, {"reserve_fraction": 0.25, "reserve_floor": 2, "expand_margin": 1.3, "attack_margin": 1.5, "reinforce_margin": 2, "aux": 1.0}], "ai_strategy": ["heuristic", "rusherplus", "heuristic", "heuristic", "heuristic", "heuristic"], "custom_map": null, "challenge": null}},
  {"id": 3, "title": "Defender's edge", "briefing": ["On this map, defenders have a slight advantage, so equal numbers are not enough.", "The menu's Combat tab shows how a fight comes out, with dice and all. Try a few scenarios there.", "New ships are created before fleets arrive, so count the turns until you arrive.", "The more you outnumber the enemy, the fewer you lose, but the sooner you capture, the more you can produce"], "hint": "Defenders have the edge: attack with a margin. The menu's Combat tab shows the odds.",
